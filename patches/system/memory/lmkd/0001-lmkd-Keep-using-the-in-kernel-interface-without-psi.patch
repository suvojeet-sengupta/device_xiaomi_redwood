From 8750b086f25d29640a0f965186f693420662eea8 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Mon, 5 Oct 2026 13:12:18 +0000
Subject: [PATCH] lmkd: Keep using the in-kernel interface without psi

Kernels with an in-kernel low memory killer and no psi (like Simple
LMK) can force the in-kernel interface with ro.vendor.lmk.force_inkernel_lmk,
but reinitializing dropped it again and LMK_START_MONITORING after boot
tried to set up psi monitors regardless. Both made lmkd exit, and init
reboots the device once the critical lmkd keeps crashing.
---
 lmkd.cpp | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/lmkd.cpp b/lmkd.cpp
index 97526af..558f28a 100644
--- a/lmkd.cpp
+++ b/lmkd.cpp
@@ -2007,8 +2007,9 @@ static void ctrl_command_handler(int dsock_idx) {
     case LMK_START_MONITORING:
         if (nargs != 0)
             goto wronglen;
-        // Registration is needed only if it was skipped earlier.
-        if (monitors_initialized)
+        // Registration is needed only if it was skipped earlier. The in-kernel
+        // low memory killer doesn't need monitors.
+        if (monitors_initialized || use_inkernel_interface)
             return;
         if (!property_get_bool("sys.boot_completed", false)) {
             ALOGE("LMK_START_MONITORING cannot be handled before boot completed");
@@ -5241,7 +5242,8 @@ static void update_perf_props() {
         use_harden_limit = (!strncmp(property,"false",PROPERTY_VALUE_MAX))? false : true;
 
         //Update kernel interface during re-init.
-        use_inkernel_interface = has_inkernel_module && !enable_userspace_lmk;
+        use_inkernel_interface = has_inkernel_module &&
+            (property_get_bool("ro.vendor.lmk.force_inkernel_lmk", false) || !enable_userspace_lmk);
     }
 
     /* Load IOP library for PApps */
