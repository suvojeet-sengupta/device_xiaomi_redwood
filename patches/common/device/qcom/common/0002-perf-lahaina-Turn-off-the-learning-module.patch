From 0e8597319ca862b033927aefaa0faf298db7f058 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Fri, 9 Oct 2026 16:39:02 +0530
Subject: [PATCH] perf: lahaina: Turn off the learning module

Its PerfCountersMeter reads a cpu_instruction node that the 5.4 kernels
on lahaina don't have, so it logged an error every few seconds and the
adaptive launch data never got collected.
---
 vendor/perf/configs/lahaina/perf/perfconfigstore.xml | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/vendor/perf/configs/lahaina/perf/perfconfigstore.xml b/vendor/perf/configs/lahaina/perf/perfconfigstore.xml
index e9c421c..9cd2cbc 100644
--- a/vendor/perf/configs/lahaina/perf/perfconfigstore.xml
+++ b/vendor/perf/configs/lahaina/perf/perfconfigstore.xml
@@ -34,7 +34,10 @@ ________________________________________________________________________________
                 <!--Vendor Properties -->
                 <!-- AOSPA Edit: Comment out IOP
                 <Prop Name="vendor.iop.enable_uxe" Value="1" /> -->
-                <Prop Name="vendor.debug.enable.lm" Value="true" />
+                <!-- The learning module's meters read CPU counter nodes the
+                     5.4 kernels on lahaina don't have, so it failed every few
+                     seconds and never learned anything -->
+                <Prop Name="vendor.debug.enable.lm" Value="false" />
                 <!-- AOSPA Edit: Comment out IOP
                 <Prop Name="vendor.perf.iop_v3.enable" Value="true" Target="lahaina" />
                 <Prop Name="vendor.perf.iop_v3.enable.debug" Value="false" />
-- 
2.55.0

