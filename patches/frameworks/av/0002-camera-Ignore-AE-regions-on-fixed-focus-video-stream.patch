From 9fa400605debb3408fa69813fb817a62638614e4 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Tue, 6 Oct 2026 20:47:48 +0000
Subject: [PATCH] camera: Ignore AE regions on fixed focus video streams

Tapping to meter while redwood's front camera records 30 fps video with
stabilization stalls the SelfieEIS pipeline. The capture with the AE
region makes Xiaomi's ica node wait for OEM face detection results that
are never published, so no request completes until the CamX watchdog
rebuilds the pipeline after 133 frames, freezing the preview for about
5 seconds on every tap. 60 fps doesn't use that pipeline.

For fixed focus cameras on video streams, send a zero weight AE region,
which the HAL ignores.
---
 .../device3/Camera3Device.cpp                 | 21 +++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/services/camera/libcameraservice/device3/Camera3Device.cpp b/services/camera/libcameraservice/device3/Camera3Device.cpp
index 8f57cf587d..367a565733 100644
--- a/services/camera/libcameraservice/device3/Camera3Device.cpp
+++ b/services/camera/libcameraservice/device3/Camera3Device.cpp
@@ -4221,6 +4221,27 @@ status_t Camera3Device::RequestThread::prepareHalRequests() {
                 const uint8_t afTriggerIdle = ANDROID_CONTROL_AF_TRIGGER_IDLE;
                 settings.update(ANDROID_CONTROL_AF_TRIGGER, &afTriggerIdle, 1);
             }
+            // Tap to meter on a stabilized video stream stalls redwood's front
+            // camera pipeline: it waits on face results that never come until
+            // the CamX watchdog rebuilds it. Ignore metering regions there.
+            camera_metadata_entry intent = settings.find(ANDROID_CONTROL_CAPTURE_INTENT);
+            camera_metadata_entry fpsRange = settings.find(ANDROID_CONTROL_AE_TARGET_FPS_RANGE);
+            bool video = (intent.count > 0 &&
+                    (intent.data.u8[0] == ANDROID_CONTROL_CAPTURE_INTENT_VIDEO_RECORD ||
+                    intent.data.u8[0] == ANDROID_CONTROL_CAPTURE_INTENT_VIDEO_SNAPSHOT)) ||
+                    (fpsRange.count == 2 && fpsRange.data.i32[0] > 0 &&
+                    fpsRange.data.i32[0] == fpsRange.data.i32[1]);
+            camera_metadata_entry aeRegions = settings.find(ANDROID_CONTROL_AE_REGIONS);
+            if (video && aeRegions.count >= 5) {
+                bool weighted = false;
+                for (size_t i = 4; i < aeRegions.count; i += 5) {
+                    weighted |= aeRegions.data.i32[i] > 0;
+                }
+                if (weighted) {
+                    const int32_t noRegion[5] = {0, 0, 0, 0, 0};
+                    settings.update(ANDROID_CONTROL_AE_REGIONS, noRegion, 5);
+                }
+            }
         }
 
         int triggerCount = res;
-- 
2.43.0

