From 69c3e0a9e772c6ced14510d11a7300996605a10c Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Tue, 6 Oct 2026 03:16:23 +0000
Subject: [PATCH] camera: Keep AF off on fixed focus cameras

Some apps send AF_MODE_AUTO and AF triggers to cameras that only list
AF_MODE_OFF. The HAL should ignore them, but on redwood the front camera
video pipeline with stabilization stalls on every tap to focus until the
CamX watchdog rebuilds it, freezing the preview for about 5 seconds.

For fixed focus cameras, send AF_MODE_OFF and AF_TRIGGER_IDLE to the HAL.
---
 .../device3/Camera3Device.cpp                 | 22 +++++++++++++++++++
 .../libcameraservice/device3/Camera3Device.h  |  2 ++
 2 files changed, 24 insertions(+)

diff --git a/services/camera/libcameraservice/device3/Camera3Device.cpp b/services/camera/libcameraservice/device3/Camera3Device.cpp
index f3b8cab0f8..620905cb4d 100644
--- a/services/camera/libcameraservice/device3/Camera3Device.cpp
+++ b/services/camera/libcameraservice/device3/Camera3Device.cpp
@@ -235,6 +235,11 @@ status_t Camera3Device::initializeCommonLocked(sp<CameraProviderManager> manager
         }
     }
 
+    camera_metadata_entry_t availableAfModes = mDeviceInfo.find(
+            ANDROID_CONTROL_AF_AVAILABLE_MODES);
+    mFixedFocus = availableAfModes.count == 0 || (availableAfModes.count == 1 &&
+            availableAfModes.data.u8[0] == ANDROID_CONTROL_AF_MODE_OFF);
+
     camera_metadata_entry_t availableSettingsOverrides = mDeviceInfo.find(
             ANDROID_CONTROL_AVAILABLE_SETTINGS_OVERRIDES);
     for (size_t i = 0; i < availableSettingsOverrides.count; i++) {
@@ -4180,6 +4185,23 @@ status_t Camera3Device::RequestThread::prepareHalRequests() {
             return INVALID_OPERATION;
         }
 
+        // Apps still send AF modes and triggers to fixed focus cameras, which
+        // they should ignore but some HALs stall on. Keep AF off for them.
+        sp<Camera3Device> parent = mParent.promote();
+        if (parent != nullptr && parent->mFixedFocus) {
+            CameraMetadata &settings = captureRequest->mSettingsList.begin()->metadata;
+            camera_metadata_entry afMode = settings.find(ANDROID_CONTROL_AF_MODE);
+            if (afMode.count > 0 && afMode.data.u8[0] != ANDROID_CONTROL_AF_MODE_OFF) {
+                const uint8_t afModeOff = ANDROID_CONTROL_AF_MODE_OFF;
+                settings.update(ANDROID_CONTROL_AF_MODE, &afModeOff, 1);
+            }
+            camera_metadata_entry afTrigger = settings.find(ANDROID_CONTROL_AF_TRIGGER);
+            if (afTrigger.count > 0 && afTrigger.data.u8[0] != ANDROID_CONTROL_AF_TRIGGER_IDLE) {
+                const uint8_t afTriggerIdle = ANDROID_CONTROL_AF_TRIGGER_IDLE;
+                settings.update(ANDROID_CONTROL_AF_TRIGGER, &afTriggerIdle, 1);
+            }
+        }
+
         int triggerCount = res;
         bool triggersMixedIn = (triggerCount > 0 || mPrevTriggers > 0);
         mPrevTriggers = triggerCount;
diff --git a/services/camera/libcameraservice/device3/Camera3Device.h b/services/camera/libcameraservice/device3/Camera3Device.h
index dcc1280d93..53602be173 100644
--- a/services/camera/libcameraservice/device3/Camera3Device.h
+++ b/services/camera/libcameraservice/device3/Camera3Device.h
@@ -1642,6 +1642,8 @@ class Camera3Device :
 
     // Whether the HAL supports camera muting via test pattern
     bool mSupportCameraMute = false;
+    // Whether the camera is fixed focus, it only lists AF_MODE_OFF
+    bool mFixedFocus = false;
     // Whether the HAL supports SOLID_COLOR or BLACK if mSupportCameraMute is true
     bool mSupportTestPatternSolidColor = false;
     // Whether the HAL supports zoom settings override
