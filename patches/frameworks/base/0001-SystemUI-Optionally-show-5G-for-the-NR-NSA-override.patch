From dfbafcfc68a4bc46e5b6d5d7c03026b47afe50d6 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Mon, 5 Oct 2026 21:49:21 +0000
Subject: [PATCH] SystemUI: Optionally show 5G for the NR NSA override

Without a QTI NR icon type, an NR NSA override from TelephonyDisplayInfo
is shown with the anchor network's icon, so devices whose modem never
reports an NR icon type show 4G on 5G NSA networks. Add an overlayable
config to show the override's 5G icon in that case.
---
 packages/SystemUI/res/values/aospa_config.xml            | 4 ++++
 .../mobile/domain/interactor/MobileIconInteractor.kt     | 9 ++++++++-
 2 files changed, 12 insertions(+), 1 deletion(-)

diff --git a/packages/SystemUI/res/values/aospa_config.xml b/packages/SystemUI/res/values/aospa_config.xml
index 3fec3b25e393..e9c8a4fd030a 100644
--- a/packages/SystemUI/res/values/aospa_config.xml
+++ b/packages/SystemUI/res/values/aospa_config.xml
@@ -47,4 +47,8 @@
           <item>4095,0</item>
     </string-array>
 
+    <!-- Show the 5G icon for the NR NSA override from TelephonyDisplayInfo when
+         there's no QTI NR icon type, instead of the anchor network's icon. -->
+    <bool name="config_nrNsaIconFromDisplayInfo">false</bool>
+
 </resources>
diff --git a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/domain/interactor/MobileIconInteractor.kt b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/domain/interactor/MobileIconInteractor.kt
index 166182113ea0..0bec562aaa5c 100644
--- a/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/domain/interactor/MobileIconInteractor.kt
+++ b/packages/SystemUI/src/com/android/systemui/statusbar/pipeline/mobile/domain/interactor/MobileIconInteractor.kt
@@ -537,7 +537,7 @@ class MobileIconInteractorImpl(
 
     private fun getLookupKey(resolvedNetworkType: ResolvedNetworkType,
                              customizationInfo: MobileIconCustomizationMode): String {
-        return if (isNsa(resolvedNetworkType.networkType)) {
+        return if (isNsa(resolvedNetworkType.networkType) && !nrNsaIconFromDisplayInfo) {
             if (customizationInfo.originNetworkType  == TelephonyManager.NETWORK_TYPE_UNKNOWN) {
                 MobileMappings.toIconKey(customizationInfo.voiceNetworkType)
             }else {
@@ -548,6 +548,13 @@ class MobileIconInteractorImpl(
         }
     }
 
+    // Without a QTI NR icon type, the NSA override from TelephonyDisplayInfo
+    // falls back to the anchor's icon (4G). Devices whose modem never reports
+    // one can show the override's 5G icon instead.
+    private val nrNsaIconFromDisplayInfo: Boolean by lazy {
+        context.resources.getBoolean(com.android.systemui.res.R.bool.config_nrNsaIconFromDisplayInfo)
+    }
+
     private fun isNsa(networkType: Int): Boolean {
         return networkType == TelephonyDisplayInfo.OVERRIDE_NETWORK_TYPE_NR_NSA_MMWAVE
                 || networkType == TelephonyDisplayInfo.OVERRIDE_NETWORK_TYPE_NR_NSA
-- 
2.43.0

