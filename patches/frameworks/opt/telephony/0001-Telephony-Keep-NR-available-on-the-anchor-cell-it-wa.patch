From 42e9f70fd9da3e9a95918749e326642cb4c9ce53 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Mon, 5 Oct 2026 20:57:43 +0000
Subject: [PATCH] Telephony: Keep NR available on the anchor cell it was seen
 on

Some modems never report EN-DC availability (isEnDcAvailable is always
false) and only show NR through the physical channel configs, which drop
the NR secondary cell every few seconds and whenever the connection goes
idle. The NR state then falls to NONE and the status bar shows 4G on a
5G NSA network.

When ro.telephony.sticky_nr_anchor is set, remember the LTE cell an NR
secondary cell was last seen on and report NR as available, not
restricted, while camped on it. Moving to another cell clears it.
---
 .../telephony/ServiceStateTracker.java        | 19 +++++++++++++++++++
 1 file changed, 19 insertions(+)

diff --git a/src/java/com/android/internal/telephony/ServiceStateTracker.java b/src/java/com/android/internal/telephony/ServiceStateTracker.java
index 1774b5d19e..5b134067c1 100644
--- a/src/java/com/android/internal/telephony/ServiceStateTracker.java
+++ b/src/java/com/android/internal/telephony/ServiceStateTracker.java
@@ -189,6 +189,14 @@ public class ServiceStateTracker extends Handler {
     private List<CellInfo> mLastCellInfoList = null;
     private List<PhysicalChannelConfig> mLastPhysicalChannelConfigList = null;
 
+    // Some modems never report EN-DC availability and only show NR through the
+    // physical channel configs, which drop the NR secondary cell whenever it's
+    // released. Remember the LTE cell it was last seen on and keep NR available
+    // while camped on it.
+    private static final boolean STICKY_NR_ANCHOR =
+            SystemProperties.getBoolean("ro.telephony.sticky_nr_anchor", false);
+    private String mNrAnchorCellId = null;
+
     private final Set<Integer> mRadioPowerOffReasons = new HashSet<>();
 
     // TODO - this should not be public, right now used externally GsmConnection.
@@ -1750,13 +1758,24 @@ public class ServiceStateTracker extends Handler {
             }
         }
 
+        CellIdentity cellIdentity = regInfo.getCellIdentity();
+        String lteCellId = cellIdentity instanceof CellIdentityLte
+                ? cellIdentity.getGlobalCellId() : null;
+
         int oldNrState = regInfo.getNrState();
         int newNrState;
         if (hasNrSecondaryServingCell) {
             newNrState = NetworkRegistrationInfo.NR_STATE_CONNECTED;
+            if (lteCellId != null) {
+                mNrAnchorCellId = lteCellId;
+            }
         } else {
             regInfo.updateNrState();
             newNrState = regInfo.getNrState();
+            if (STICKY_NR_ANCHOR && newNrState == NetworkRegistrationInfo.NR_STATE_NONE
+                    && lteCellId != null && lteCellId.equals(mNrAnchorCellId)) {
+                newNrState = NetworkRegistrationInfo.NR_STATE_NOT_RESTRICTED;
+            }
         }
 
         boolean hasChanged = newNrState != oldNrState;
-- 
