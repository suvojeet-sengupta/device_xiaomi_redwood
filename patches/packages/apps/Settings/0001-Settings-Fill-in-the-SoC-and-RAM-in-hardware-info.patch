From 7215cf1d35eda47b35ca971cd08822a0ff75baf4 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Mon, 5 Oct 2026 20:28:35 +0000
Subject: [PATCH] Settings: Fill in the SoC and RAM in hardware info

The page lists SoC Model and Total RAM but their controllers were never
added, so both were blank. Show ro.aospa.soc_name, or the SoC from Build,
and the RAM size rounded up to whole GB. Also give the device status
category a real title.
---
 res/values/aospa_strings.xml                  |  1 +
 res/xml/hardware_info.xml                     |  2 +-
 .../SoCModelPreferenceController.java         | 43 ++++++++++++++
 .../TotalRAMPreferenceController.java         | 58 +++++++++++++++++++
 4 files changed, 103 insertions(+), 1 deletion(-)
 create mode 100644 src/com/android/settings/deviceinfo/hardwareinfo/SoCModelPreferenceController.java
 create mode 100644 src/com/android/settings/deviceinfo/hardwareinfo/TotalRAMPreferenceController.java

diff --git a/res/values/aospa_strings.xml b/res/values/aospa_strings.xml
index 740715b904a..ddf0e8048c8 100644
--- a/res/values/aospa_strings.xml
+++ b/res/values/aospa_strings.xml
@@ -123,6 +123,7 @@
     <string name="device_market_name">Market Name</string>
     <string name="soc_model">SoC Model</string>
     <string name="total_ram">Total RAM</string>
+    <string name="device_status_category_title">Device status</string>
 
     <!-- Wifi/Bluetooth auto timeout -->
     <string name="wifi_timeout_summary_auto">WiFi will turn off after <xliff:g id="timeout_description">%1$s</xliff:g> if no network connected</string>
diff --git a/res/xml/hardware_info.xml b/res/xml/hardware_info.xml
index eb4c5c3d06f..cebb75fdad2 100644
--- a/res/xml/hardware_info.xml
+++ b/res/xml/hardware_info.xml
@@ -70,7 +70,7 @@
 
     <PreferenceCategory
         android:key="device_status_category"
-        android:title="Venkat">
+        android:title="@string/device_status_category_title">
 
         <Preference
             android:key="wifi_ip_address"
diff --git a/src/com/android/settings/deviceinfo/hardwareinfo/SoCModelPreferenceController.java b/src/com/android/settings/deviceinfo/hardwareinfo/SoCModelPreferenceController.java
new file mode 100644
index 00000000000..4d864a0dce0
--- /dev/null
+++ b/src/com/android/settings/deviceinfo/hardwareinfo/SoCModelPreferenceController.java
@@ -0,0 +1,43 @@
+/*
+ * Copyright (C) 2026 Paranoid Android
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.deviceinfo.hardwareinfo;
+
+import android.content.Context;
+import android.os.Build;
+import android.os.SystemProperties;
+import android.text.TextUtils;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+public class SoCModelPreferenceController extends BasePreferenceController {
+
+    // Marketing name of the SoC, set by the device
+    private static final String PROP_SOC_NAME = "ro.aospa.soc_name";
+
+    public SoCModelPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mContext.getResources().getBoolean(R.bool.config_show_device_model)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final String name = SystemProperties.get(PROP_SOC_NAME);
+        if (!TextUtils.isEmpty(name)) {
+            return name;
+        }
+        if (Build.SOC_MODEL.equals(Build.UNKNOWN)) {
+            return mContext.getString(R.string.device_info_default);
+        }
+        return Build.SOC_MANUFACTURER + " " + Build.SOC_MODEL;
+    }
+}
diff --git a/src/com/android/settings/deviceinfo/hardwareinfo/TotalRAMPreferenceController.java b/src/com/android/settings/deviceinfo/hardwareinfo/TotalRAMPreferenceController.java
new file mode 100644
index 00000000000..79a2bea7804
--- /dev/null
+++ b/src/com/android/settings/deviceinfo/hardwareinfo/TotalRAMPreferenceController.java
@@ -0,0 +1,58 @@
+/*
+ * Copyright (C) 2026 Paranoid Android
+ *
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package com.android.settings.deviceinfo.hardwareinfo;
+
+import android.content.Context;
+import android.util.Log;
+
+import com.android.settings.R;
+import com.android.settings.core.BasePreferenceController;
+
+import java.io.BufferedReader;
+import java.io.FileReader;
+import java.io.IOException;
+
+public class TotalRAMPreferenceController extends BasePreferenceController {
+
+    private static final String TAG = "TotalRAMPrefCtrl";
+
+    public TotalRAMPreferenceController(Context context, String preferenceKey) {
+        super(context, preferenceKey);
+    }
+
+    @Override
+    public int getAvailabilityStatus() {
+        return mContext.getResources().getBoolean(R.bool.config_show_device_model)
+                ? AVAILABLE : UNSUPPORTED_ON_DEVICE;
+    }
+
+    @Override
+    public CharSequence getSummary() {
+        final long kb = getMemTotalKb();
+        if (kb <= 0) {
+            return mContext.getString(R.string.device_info_default);
+        }
+        // MemTotal leaves out what the kernel and firmware reserve, so round
+        // up to the size the device is sold with.
+        final long gb = (kb + 1024 * 1024 - 1) / (1024 * 1024);
+        return gb + " GB";
+    }
+
+    private static long getMemTotalKb() {
+        try (BufferedReader reader = new BufferedReader(new FileReader("/proc/meminfo"))) {
+            String line;
+            while ((line = reader.readLine()) != null) {
+                if (line.startsWith("MemTotal:")) {
+                    return Long.parseLong(line.replaceAll("[^0-9]", ""));
+                }
+            }
+        } catch (IOException | NumberFormatException e) {
+            Log.e(TAG, "Failed to read MemTotal", e);
+        }
+        return 0;
+    }
+}
