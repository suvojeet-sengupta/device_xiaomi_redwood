From cd3648f598370a38731c3659b64e9f31ecd75e7d Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <devjit.neogi@gmail.com>
Date: Mon, 5 Oct 2026 10:05:14 +0000
Subject: [PATCH 3/4] LocalNetEventListener: Handle a missing ring buffer

The local net note op ring buffer needs kernel 5.8+ and isn't loaded on
older kernels, where constructing its wrapper aborts system_server.
Don't collect local net access events there instead.
---
 .../native/libs/libeventpolling/LocalNetEventHandler.cpp  | 8 ++++++++
 .../include/libeventpolling/LocalNetEventHandler.h        | 4 +++-
 .../server/connectivity/LocalNetEventListener.java        | 6 ++++++
 3 files changed, 17 insertions(+), 1 deletion(-)

diff --git a/service/native/libs/libeventpolling/LocalNetEventHandler.cpp b/service/native/libs/libeventpolling/LocalNetEventHandler.cpp
index 59c2844..1acddf9 100644
--- a/service/native/libs/libeventpolling/LocalNetEventHandler.cpp
+++ b/service/native/libs/libeventpolling/LocalNetEventHandler.cpp
@@ -18,6 +18,7 @@
 #include "libeventpolling/LocalNetEventHandler.h"
 
 #include <memory>
+#include <unistd.h>
 #include <vector>
 
 #include <bpf/BpfRingbuf.h>
@@ -36,6 +37,12 @@ using bpf::RingbufEventPoller;
 LocalNetEventHandler::LocalNetEventRingbuf *LocalNetEventHandler::GetRingbuf() {
     static LocalNetEventRingbuf *const sRingbuf =
         []() -> LocalNetEventRingbuf * {
+        // The ring buffer needs kernel 5.8+, it doesn't get loaded on older
+        // kernels. Constructing the wrapper would abort then.
+        if (access(LOCAL_NET_NOTE_OP_RINGBUF_PATH, F_OK)) {
+            ALOGW("No local net event ring buffer, not collecting events");
+            return nullptr;
+        }
         auto rb = std::make_unique<LocalNetEventRingbuf>(
             LOCAL_NET_NOTE_OP_RINGBUF_PATH);
         return rb.release();
@@ -46,6 +53,7 @@ LocalNetEventHandler::LocalNetEventRingbuf *LocalNetEventHandler::GetRingbuf() {
 // static
 std::vector<uint32_t> LocalNetEventHandler::ConsumeAll() {
     std::vector<uint32_t> uids_pids;
+    if (!GetRingbuf()) return uids_pids;
     base::Result<int> ret =
         GetRingbuf()->ConsumeAll([&](const LocalNetNoteOp &event) {
             uids_pids.push_back(event.uid);
diff --git a/service/native/libs/libeventpolling/include/libeventpolling/LocalNetEventHandler.h b/service/native/libs/libeventpolling/include/libeventpolling/LocalNetEventHandler.h
index ce46620..7c35b38 100644
--- a/service/native/libs/libeventpolling/include/libeventpolling/LocalNetEventHandler.h
+++ b/service/native/libs/libeventpolling/include/libeventpolling/LocalNetEventHandler.h
@@ -36,7 +36,9 @@ class LocalNetEventHandler {
     // Returns a duplicate of the ring buffer file descriptor. This is needed so
     // we can pass the file descriptor via jni for use in polling in java.
     static android::base::unique_fd GetNewRingbufFd() {
-        return GetRingbuf()->GetDuplicateFd();
+        LocalNetEventRingbuf *ringbuf = GetRingbuf();
+        if (!ringbuf) return android::base::unique_fd();
+        return ringbuf->GetDuplicateFd();
     }
 
     // Consumes all available events in the ring buffer. Returns a list of
diff --git a/service/src/com/android/server/connectivity/LocalNetEventListener.java b/service/src/com/android/server/connectivity/LocalNetEventListener.java
index e8d495c..c69391b 100644
--- a/service/src/com/android/server/connectivity/LocalNetEventListener.java
+++ b/service/src/com/android/server/connectivity/LocalNetEventListener.java
@@ -98,6 +98,12 @@ public class LocalNetEventListener {
         if (mStarted) {
             return;
         }
+        if (mRingbufFd == null) {
+            // No ring buffer on kernels older than 5.8
+            Log.w(TAG, "Local net access ring buffer unavailable, not listening");
+            mStarted = true;
+            return;
+        }
         if (mMetricsEnabled || mNoteOpsEnabled) {
             mLooper.getQueue().addOnFileDescriptorEventListener(mRingbufFd,
                     EVENT_INPUT | EVENT_ERROR, this::consumeEvents);
