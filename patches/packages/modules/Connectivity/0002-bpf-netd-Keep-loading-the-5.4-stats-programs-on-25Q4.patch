From 1f1f5429fe68a64159cfe3070b21ef8489925935 Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <devjit.neogi@gmail.com>
Date: Mon, 5 Oct 2026 08:32:47 +0000
Subject: [PATCH 2/4] bpf: netd: Keep loading the 5.4 stats programs on 25Q4+

25Q4 dropped the 5.4 variant of the ingress/egress stats programs, so
nothing gets loaded for them on 5.4 kernels and netd aborts on boot
trying to attach them. Keep using the 25Q2 variant there.
---
 bpf/progs/netd.c | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/bpf/progs/netd.c b/bpf/progs/netd.c
index e4cd7c9..76be791 100644
--- a/bpf/progs/netd.c
+++ b/bpf/progs/netd.c
@@ -1001,8 +1001,8 @@ DEFINE_NETD_BPF_PROG_RANGES(ingress, stats, 5_10, INF, 25Q2, 25Q4)
     return bpf_traffic_account(skb, INGRESS, KVER_5_10, API(25Q2));
 }
 
-// Android 25Q2/25Q3 5.4 (localnet protection)
-DEFINE_NETD_BPF_PROG_RANGES(ingress, stats, 5_4, 5_10, 25Q2, 25Q4)
+// Android 25Q2+ 5.4 (localnet protection)
+DEFINE_NETD_BPF_PROG_RANGES(ingress, stats, 5_4, 5_10, 25Q2, MAXAPI)
 (struct __sk_buff* skb) {
     return bpf_traffic_account(skb, INGRESS, KVER_5_4, API(25Q2));
 }
@@ -1057,8 +1057,8 @@ DEFINE_NETD_BPF_PROG_RANGES(egress, stats, 5_10, INF, 25Q2, 25Q4)
     return bpf_traffic_account(skb, EGRESS, KVER_5_10, API(25Q2));
 }
 
-// Android 25Q2/25Q3 5.4 (localnet protection)
-DEFINE_NETD_BPF_PROG_RANGES(egress, stats, 5_4, 5_10, 25Q2, 25Q4)
+// Android 25Q2+ 5.4 (localnet protection)
+DEFINE_NETD_BPF_PROG_RANGES(egress, stats, 5_4, 5_10, 25Q2, MAXAPI)
 (struct __sk_buff* skb) {
     return bpf_traffic_account(skb, EGRESS, KVER_5_4, API(25Q2));
 }
-- 
