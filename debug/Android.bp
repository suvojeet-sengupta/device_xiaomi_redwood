// Boot debugging: dumps logs to /metadata/redwood-debug, which survives a
// hang and can be read from recovery.

prebuilt_etc {
    name: "init.redwood.debug.rc",
    src: "init.redwood.debug.rc",
    sub_dir: "init",
    system_ext_specific: true,
}

sh_binary {
    name: "redwood-debuglog.sh",
    src: "redwood-debuglog.sh",
    system_ext_specific: true,
}
