Signed-off-by: Dmitrii <bankersenator@gmail.com>
---
 services/camera/libcameraservice/Android.bp | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/services/camera/libcameraservice/Android.bp b/services/camera/libcameraservice/Android.bp
index e8429137da..f609c861f0 100644
--- a/services/camera/libcameraservice/Android.bp
+++ b/services/camera/libcameraservice/Android.bp
@@ -133,7 +133,6 @@ cc_library {
 
     defaults: [
         "libcameraservice_deps",
-        "libcameraservice_ext_lib_defaults",
     ],
     // Camera service source
 
@@ -311,7 +310,14 @@ cc_library_static {
         "-Wextra",
         "-Werror",
         "-Wno-ignored-qualifiers",
-    ],
+    ] + select(soong_config_variable("libcameraservice", "ext_lib"), {
+        any @ flag_val: ["-DTARGET_PROVIDES_CAMERA_PROVIDER_EXT_LIB"],
+        default: [],
