From 2438535c4d85356b794e98db3c2dfb7251d16c5f Mon Sep 17 00:00:00 2001
From: suvojeet-sengupta <suvojitsengupta21@gmail.com>
Date: Wed, 7 Oct 2026 00:51:12 +0000
Subject: [PATCH] gms: Drop WebViewGoogle64

It only has 64 bit libraries but declares multiArch, so Android 17
refuses to install it on devices with 32 bit ABIs. Since it overrides the
AOSP WebView, there was no WebView at all, and Setup Wizard and Play
Store crashed on a clean flash. Without it the AOSP WebView, which has
32 and 64 bit libraries, gets installed.
---
 gms-vendor.mk | 1 -
 1 file changed, 1 deletion(-)

diff --git a/gms-vendor.mk b/gms-vendor.mk
index 476b8e7..d652491 100644
--- a/gms-vendor.mk
+++ b/gms-vendor.mk
@@ -112,7 +112,6 @@ PRODUCT_PACKAGES += \
     Photos \
     SpeechServicesByGoogle \
     TrichromeLibrary64 \
-    WebViewGoogle64 \
     YouTube \
     talkback \
     AndroidAutoStub \
-- 
2.43.0

