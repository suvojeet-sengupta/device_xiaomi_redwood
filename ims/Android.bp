// The redwood qcril only serves IImsRadio over HIDL, but the ImsService in
// the calcite telephony component only talks to the AIDL one, so MMTEL never
// becomes available and there's no VoLTE. Ship the last one that still falls
// back to HIDL, from LA.QISI.16.0.r2-00900-qssi.0 (ThankYouMario's
// proprietary_vendor_qcom_common@846afd36fe).
android_app_import {
    name: "ims_hidl",
    apk: "ims.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
    overrides: [
        "ims",
        "system_ext_priv-app_ims_lib_arm64_libimsmedia_jni_so",
    ],
    required: [
        "ims_hidl_libimsmedia_jni",
        "ims_hidl_libimsmedia_jni_symlink",
    ],
}

// The calcite libimsmedia_jni fails JNI_OnLoad with this ImsService, use
// the one it shipped with. It keeps its own name so it doesn't clash with
// the calcite one, the symlink below gives it the name the app loads.
cc_prebuilt_library_shared {
    name: "ims_hidl_libimsmedia_jni",
    stem: "libimsmedia_jni_a16",
    srcs: ["libimsmedia_jni.so"],
    compile_multilib: "64",
    strip: {
        none: true,
    },
    shared_libs: [
        "libandroid",
        "libbinder",
        "libcutils",
        "libgui",
        "liblog",
        "libnativehelper",
        "libutils",
    ],
    check_elf_files: false,
    system_ext_specific: true,
}

install_symlink {
    name: "ims_hidl_libimsmedia_jni_symlink",
    system_ext_specific: true,
    installed_location: "priv-app/ims_hidl/lib/arm64/libimsmedia_jni.so",
    symlink_target: "/system_ext/lib64/libimsmedia_jni_a16.so",
}
